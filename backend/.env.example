# Postgres connection string used by config/database.js
DATABASE_URL=postgresql://username:password@localhost:5432/electrolead
DB_POOL_MAX=10

# The test suite TRUNCATEs every table, so it refuses to run unless it is
# pointed at a disposable database: either set this, or give DATABASE_URL a
# database name ending in _test. Never point it at production.
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/electrolead_test

# Server
PORT=3000
NODE_ENV=development
# Only matters for browser-facing CORS; with the Next.js server-side proxy in place this is rarely hit directly.
FRONTEND_URL=http://localhost:3001

# Auth (middleware/auth.js)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=7d

# OTP (utils/otp.js) - email-based, not SMS
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Email (config/email.js).
# Setting RESEND_API_KEY is enough: the app then sends over Resend's HTTPS API,
# which is the only reliable path on hosts that block outbound SMTP ports
# (Render does - this is why SMTP delivery was timing out there).
# Force the SMTP path instead with EMAIL_PROVIDER=smtp.
RESEND_API_KEY=
# Must be a domain verified in Resend. Without one, Resend only delivers to the
# account owner's own address via its onboarding@resend.dev test sender.
EMAIL_FROM=VoltSupply <noreply@yourdomain.com>

EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sign-ins allowed per IP per 15 minutes (failed attempts only). Default 20.
LOGIN_RATE_LIMIT=20

# Cloudinary (config/cloudinary.js) - stores KYC (PAN/GST) documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (config/razorpay.js) - use test mode keys for now
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
